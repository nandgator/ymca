# Copy to .env.prod on the EC2 instance and fill in real values.
# NEVER commit the filled-in .env.prod to version control.

POSTGRES_USER=mess
POSTGRES_PASSWORD=change-me-to-a-long-random-value
POSTGRES_DB=ymca_mess

# Must be a real domain name pointing (A record) at this instance's public
# IP — Caddy uses it to request a Let's Encrypt certificate automatically.
# A bare IP address will NOT work for automatic HTTPS.
DOMAIN=mess.yourdomain.com
